# ============================================================
# Yandex AI Studio (OpenAI-совместимый API)
# ============================================================

# Имя переменной окружения, в которой лежит API-ключ.
# ВАЖНО: при смене месяца меняйте имя (например, september2026) и
# обновляйте YANDEX_API_KEY_ENV.
YANDEX_API_KEY_ENV=august2026

# API-ключ (название )
august2026=ваш_ключ_здесь

# Идентификатор каталога Yandex Cloud
YANDEX_FOLDER_ID=b1gd8itqunasnf56lij4

# Модель (без префикса gpt://)
YANDEX_MODEL=qwen3.6-35b-a3b/latest

# Базовый URL OpenAI-совместимого API
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# ============================================================
# Yandex Realtime API (голосовой режим)
# ============================================================

# Модель Realtime API
YANDEX_REALTIME_MODEL=speech-realtime-250923/latest

# ID промпта для Realtime API (опционально)
YANDEX_REALTIME_PROMPT_ID=

# ============================================================
# MCP-сервер Туту
# ============================================================

MCP_URL=https://mcp.tutu.ru/mcp

# ============================================================
# Агент
# ============================================================

# Максимальное число итераций агентного цикла
MAX_AGENT_ITERATIONS=12

# Включать ли скилы в реестр инструментов
SKILLS_ENABLED=true

# ============================================================
# Логирование
# ============================================================

LOG_FILE=logs.txt
LOG_LEVEL=DEBUG

# ============================================================
# FastAPI
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000